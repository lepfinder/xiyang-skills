# 阿里万相 / DashScope（二选一变量名均可）
DASHSCOPE_API_KEY=sk-xxxxxxxx
# WANXIANG_API_KEY=sk-xxxxxxxx

# 可选：覆盖默认万相 endpoint（含 compatible-mode 时走 OpenAI 兼容格式）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# Google Gemini 图像生成
GEMINI_API_KEY=AIzaSyxxxxxxxx

# 可选：自定义生图记录文件路径（默认 .agents/skills/generate-image/logs/generations.jsonl）
# IMAGE_GEN_LOG=~/.ada/image-generation-log.jsonl
